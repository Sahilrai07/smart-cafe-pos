# ==============================================================================
# ENVIRONMENT VARIABLES - CAFE SAAS (QUICK BITE CAFE)
# ==============================================================================

# Supabase Configuration (Free Tier)
# Obtain these from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used only in secure server actions/routes when administrative bypass is needed
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Application Base URL
# Local: http://localhost:3000
# Production: https://your-app-name.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode: Set to "true" to run with local mock store if Supabase credentials are not yet configured.
# When Supabase URL is supplied, it connects automatically to PostgreSQL.
NEXT_PUBLIC_DEMO_MODE=true
